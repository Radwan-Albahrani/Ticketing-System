{
  "name": "loura",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint . && bun tools/lint-architecture.ts",
    "test": "bun test",
    "commitlint": "commitlint",
    "prepare": "bun tools/install-hooks.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0",
    "turbo": "^2.6.0",
    "prettier": "3.6.2"
  }
}
