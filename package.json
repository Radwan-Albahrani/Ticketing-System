{
  "name": "loura",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --deny-warnings . && bun tools/lint-architecture.ts",
    "test": "bun test",
    "commitlint": "commitlint",
    "prepare": "bun tools/install-hooks.ts",
    "check": "bun run lint && bun check --no-script"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "typescript": "7.0.2",
    "@types/bun": "^1.3.0",
    "turbo": "^2.6.0",
    "oxlint": "1.91.0",
    "oxc-parser": "0.157.0"
  }
}
